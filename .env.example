# No-Trustees Mode Environment Configuration
# Copy this file to .env and replace placeholder values
#
# SECURITY: Never commit actual secrets to version control!
# Use a secrets manager in production.

# =============================================================================
# REQUIRED - Core Configuration
# =============================================================================

# Stripe API secret key (sk_live_xxx for production, sk_test_xxx for testing)
STRIPE_SECRET=sk_test_your_stripe_secret_key_here

# Stripe webhook signing secret (whsec_xxx)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Stripe Price ID for subscription products
PRICE_ID=price_your_price_id_here

# Admin API key for protected endpoints
# Generate a secure random key: openssl rand -hex 32
ADMIN_API_KEY=your_secure_admin_api_key_here

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server port (default: 3000)
PORT=3000

# Public URL for callbacks (no trailing slash)
PUBLIC_URL=https://your-domain.com

# =============================================================================
# NO-TRUSTEES MODE SETTINGS
# =============================================================================

# Enable/disable trustee oversight (false for No-Trustees Mode)
TRUSTEES_ENABLED=false

# Enable manual review gates
MANUAL_REVIEW_ENABLED=false

# Enable enforcer bot for automated actions
ENFORCER_BOT_ENABLED=false

# Enable automatic compliance anchoring
AUTO_ANCHOR_COMPLIANCE=true

# Blockchain for anchoring (bsc, eth, polygon)
COMPLIANCE_ANCHOR_CHAIN=bsc

# Tenant identifier for multi-tenant deployments
TENANT_ID=default

# =============================================================================
# NOTIFICATIONS - Slack
# =============================================================================

# Slack incoming webhook URL
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# =============================================================================
# NOTIFICATIONS - Email (SMTP)
# =============================================================================

# SMTP server hostname
SMTP_HOST=smtp.example.com

# SMTP server port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP authentication username (usually email address)
SMTP_USER=notifications@example.com

# SMTP authentication password
SMTP_PASS=your_smtp_password_here

# =============================================================================
# TIMEZONE
# =============================================================================

# Timezone for timestamps (recommend UTC for consistency)
TZ=UTC

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================

# Node environment (development, production, test)
NODE_ENV=development

# Enable debug logging
DEBUG=false
